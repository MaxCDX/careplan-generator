# =========================================
# Frontend
# Browser -> FastAPI backend base URL
# =========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000


# =========================================
# OpenAI / LLM
# Used for future care plan generation
# =========================================
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini


# =========================================
# PostgreSQL
# Durable system-of-record database
# =========================================
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/careplan


# =========================================
# Redis Queue
# Used for asynchronous job dispatch.
# Queue stores order_id references only, not full patient/provider payloads.
#
# Docker Compose backend containers should use the Redis service name:
#   redis://redis:6379/0
# If running the backend directly on your host machine, use:
#   redis://localhost:6379/0
# =========================================
REDIS_URL=redis://redis:6379/0
CARE_PLAN_QUEUE_NAME=care_plan_jobs