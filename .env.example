# =========================================
# Frontend
# Browser -> FastAPI backend base URL
# =========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000


# =========================================
# OpenAI / LLM configuration
# =========================================
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
LLM_MODEL=gpt-4o-mini
# Legacy deployments may still provide OPENAI_MODEL as a fallback.

# LLM provider mode:
# - openai: real API calls
# - mock: deterministic fake responses for local testing
LLM_PROVIDER=openai

# Optional artificial delay in seconds for mock LLM mode.
MOCK_LLM_DELAY_SECS=0


# =========================================
# PostgreSQL
# Durable system-of-record database
# =========================================
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/careplan


# =========================================
# Celery / Redis
# Redis is used by Celery for task dispatch and task state.
# Task payloads contain order_id references only, not full patient/provider payloads.
# =========================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
